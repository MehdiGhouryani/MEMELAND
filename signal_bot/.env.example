# کپی کن به .env و مقادیر واقعی رو پر کن. .env هرگز commit نشه (تو .gitignore هست).

# توکن ربات از BotFather
BOT_TOKEN=

# آیدی عددی ادمین‌ها، با کاما جدا (مثال: 111111111,222222222)
ADMIN_IDS=

# کلید API نوپیمنتس برای شارژ استخر جایزه
NOWPAYMENTS_API_KEY=

# مقصد کاربر بعد از پرداخت (لینک ربات/کانال)
SUCCESS_URL=https://t.me/your_bot_username

# یوزرنیم کانال برای پست خودکار لیدربورد — اختیاری
CHANNEL_ID=

# مسیر فایل دیتابیس — اختیاری، پیش‌فرض signals.db
DB_FILE=signals.db

# --- IPN نوپیمنتس (اختیاری) — بدونش فقط تأیید دستی پرداخت کار می‌کنه ---
NOWPAYMENTS_IPN_SECRET=
# آدرس عمومی HTTPS + مسیر /nowpayments-ipn (مثال: https://yourdomain.com/nowpayments-ipn)
IPN_CALLBACK_URL=
IPN_WEBHOOK_PORT=8443

# --- سایت Memeland Hub ---
# آدرس + Service Role Key پروژه‌ی Supabase (Settings → API) — فقط برای آپلود
# عکس. خالی = آپلود غیرفعال (بدون کرش). Service Key محرمانه‌ست، هیچ‌وقت سمت
# مرورگر نره.
SITE_SUPABASE_URL=
SITE_SUPABASE_SERVICE_KEY=

# آدرس HTTPS واقعیِ سایت — برای دکمه‌ی WebApp تو منوی بات. خالی = دکمه مخفیه.
SITE_URL=

# یوزرنیم بات (بدون @) برای Telegram Login Widget — باید با BotFather
# /setdomain رو همون دامنه‌ی SITE_URL هماهنگ باشه. خالی = ویجت رندر نمی‌شه.
TELEGRAM_BOT_USERNAME=

# پین‌های نقش‌ها (admin/caller/subscriber/community/unlock). خالی = اون نقش
# قابل claim نیست. تغییر یه پین از‌قبل‌ست‌شده از همینجا اثر نمی‌کنه — باید
# مستقیم ردیفش تو site.db (جدول kv_store) پاک بشه تا از .env دوباره بسازتش.
ADMIN_PIN=
CALLER_PIN=
SUBSCRIBER_PIN=
COMMUNITY_PIN=
UNLOCK_PIN=
